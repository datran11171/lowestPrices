# Copy to .env.local and fill in whichever providers you want to use.
# Any provider without credentials is skipped. With none configured,
# the app falls back to demo data (no real listings or photos).
# All searches are for the Australian market (see lib/region.ts).

# SerpApi – Google Shopping Australia: JB Hi-Fi, Harvey Norman, Officeworks,
# Amazon AU, Big W, Kogan and more, with product photos (https://serpapi.com)
SERPAPI_KEY=

# eBay Browse API – eBay Australia listings located in AU, with photos.
# Create a production keyset at https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional: your location, for more local results and accurate shipping costs
SEARCH_LOCATION=Sydney, New South Wales, Australia
POSTCODE=2000

# Set to "true" to always include demo results (useful during development)
ENABLE_DEMO_PROVIDER=
